# Optional. Leave this commented out and the app finds the backend
# automatically (it reuses the IP address of the computer running Expo).
#
# Set it only if auto-detection does not work, using your computer's
# Wi-Fi IP address (Windows: run `ipconfig`; Mac/Linux: `ifconfig`):
#
# EXPO_PUBLIC_API_URL=http://192.168.1.25:4000/api
