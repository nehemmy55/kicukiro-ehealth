# Copy this file to .env and fill in your own values.

# API server
PORT=4000

# MySQL connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=kicukiro_ehealth

# Secret used to sign login tokens (change this to a long random string)
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=8h

# SMS confirmations. Leave SMS_PROVIDER=console to just log SMS messages
# in the terminal and save them in the notifications table.
SMS_PROVIDER=console
